program Soal2;
uses crt;

var
    n : array[1..50] of integer;
    a, i, m, k : integer;

begin
clrscr;

    write('Masukkan jumlah orang 1-50 : ');
    readln(a);

    for i := 1 to n do
        begin
            write('Masukkan nilai : ');
            readln(n[i]);
            if n[i] > n[i] then
                n[i] := n[i];
            m := n[i];
        end;

        write('Nilai tertinggi : ');
end.